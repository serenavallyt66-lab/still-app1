rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Logged-in users can read and write their own draft.
    // The document ID in the 'drafts' collection must match the user's UID.
    match /drafts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
